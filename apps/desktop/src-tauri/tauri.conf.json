{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spaces",
  "version": "0.1.11",
  "identifier": "com.hosenur.space",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "spaces",
        "width": 800,
        "height": 600,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* https://github.com https://api.github.com https://api.groq.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQTM5MTc2RTBGNzg3N0UKUldSK2gvZmdkcEdqYlFrdkYraGp0UnRpeHFJTXQ0OVpzNTRtUzNIa0NBMWZnc3F6cm1zSDVnRFMK",
      "endpoints": [
        "https://github.com/hosenur/spaces/releases/latest/download/latest.json"
      ]
    }
  }
}
